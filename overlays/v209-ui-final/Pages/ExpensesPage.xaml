<Page x:Class="SweetsPOS.Pages.ExpensesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="14" FlowDirection="LeftToRight">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="+ تسجيل مصروف" Click="Add_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" HorizontalAlignment="Stretch" Spacing="3"><TextBlock Text="المصروفات" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="المصروفات المسجلة على الوردية الحالية" Foreground="{StaticResource MutedTextBrush}" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/></StackPanel></Grid>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Padding="8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="140"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Grid.Column="4" Text="التاريخ" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center"/><TextBlock Grid.Column="3" Text="التصنيف" Foreground="{StaticResource MutedTextBrush}" FlowDirection="RightToLeft" TextAlignment="Right"/><TextBlock Grid.Column="2" Text="المبلغ" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center"/><TextBlock Grid.Column="1" Text="السبب" Foreground="{StaticResource MutedTextBrush}" FlowDirection="RightToLeft" TextAlignment="Right"/><TextBlock Grid.Column="0" Text="بواسطة" Foreground="{StaticResource MutedTextBrush}" FlowDirection="RightToLeft" TextAlignment="Right"/></Grid><Grid Grid.Row="1"><ListView x:Name="List"><ListView.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="8"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="140"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Grid.Column="4" Text="{Binding CreatedAt}" TextAlignment="Center" FlowDirection="LeftToRight"/><TextBlock Grid.Column="3" Text="{Binding Category}" FlowDirection="RightToLeft" TextAlignment="Right"/><TextBlock Grid.Column="2" Text="{Binding Amount}" Foreground="{StaticResource AccentBrushSoft}" TextAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Reason}" TextTrimming="CharacterEllipsis" FlowDirection="RightToLeft" TextAlignment="Right"/><TextBlock Grid.Column="0" Text="{Binding User.DisplayName}" FlowDirection="RightToLeft" TextAlignment="Right"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView><StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><TextBlock Text="لا توجد مصروفات مسجلة" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource LightTextBrush}" TextAlignment="Center"/><TextBlock Text="ستظهر هنا المصروفات التي يتم تسجيلها على الوردية الحالية." Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center"/></StackPanel></Grid></Grid></Border>
    </Grid>
</Page>
