<Page x:Class="SweetsPOS.Pages.OnlinePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{StaticResource AppBackgroundBrush}" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24" Spacing="16" HorizontalAlignment="Stretch" FlowDirection="LeftToRight">
            <StackPanel HorizontalAlignment="Stretch" Spacing="4">
                <TextBlock Text="الإدارة السحابية" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="مزامنة بيانات المتجر ومتابعة المبيعات والورديات والتحديثات عند توفر الإنترنت." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                    <TextBlock Text="الاتصال والمزامنة" Style="{StaticResource SubTitleStyle}"/>
                    <CheckBox x:Name="OnlineEnabled" Content="تفعيل المزامنة السحابية التلقائية" HorizontalAlignment="Right" FlowDirection="RightToLeft"/>
                    <TextBox x:Name="SupabaseUrl" Header="رابط الخدمة السحابية" Visibility="Collapsed"/>
                    <PasswordBox x:Name="AnonKey" Header="مفتاح الاتصال السحابي" Visibility="Collapsed"/>
                    <TextBox x:Name="OnlineEmail" Header="البريد الإلكتروني" Visibility="Collapsed"/>
                    <PasswordBox x:Name="OnlinePassword" Header="كلمة المرور" Visibility="Collapsed"/>
                    <Grid ColumnSpacing="10" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <NumberBox Grid.Column="0" x:Name="SyncMinutes" Header="المزامنة كل (دقيقة)" Minimum="1" Maximum="120" Value="5" SpinButtonPlacementMode="Hidden" FlowDirection="RightToLeft"/>
                        <TextBox Grid.Column="1" x:Name="StoreId" Header="معرف الفرع" PlaceholderText="main" FlowDirection="RightToLeft" TextAlignment="Right"/>
                    </Grid>
                    <CheckBox x:Name="AutoUpdates" Content="تطبيق تحديثات الأصناف والأقسام الواردة من الإدارة السحابية تلقائياً" HorizontalAlignment="Right" FlowDirection="RightToLeft"/>
                    <TextBlock Text="يستمر البيع بشكل طبيعي عند انقطاع الإنترنت، وتتم المزامنة تلقائياً عند عودة الاتصال." FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                    <TextBlock Text="التحكم والمزامنة" Style="{StaticResource SubTitleStyle}"/>
                    <TextBlock x:Name="StatusText" Text="لم تبدأ المزامنة بعد" Foreground="{StaticResource AccentBrushSoft}" TextWrapping="Wrap" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" FlowDirection="LeftToRight">
                        <Button Content="تحديث البيانات الآن" Click="Updates_Click" Style="{StaticResource SoftButtonStyle}"/>
                        <Button Content="مزامنة البيانات الآن" Click="Sync_Click" Style="{StaticResource SoftButtonStyle}"/>
                        <Button Content="اختبار الاتصال" Click="Test_Click" Style="{StaticResource SoftButtonStyle}"/>
                        <Button Content="حفظ الإعدادات" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                    <InfoBar x:Name="Info" IsOpen="False" IsClosable="True"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
