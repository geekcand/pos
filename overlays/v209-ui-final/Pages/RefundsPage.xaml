<Page x:Class="SweetsPOS.Pages.RefundsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="14" FlowDirection="LeftToRight">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Stretch" Spacing="4"><TextBlock Text="المرتجعات وإلغاء الفاتورة" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="ابحث برقم الفاتورة لتنفيذ مرتجع أو إعادة طباعة" Foreground="{StaticResource MutedTextBrush}" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource InnerCardStyle}" Padding="12"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="بحث" Click="Find_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="78"/><TextBox Grid.Column="1" x:Name="InvoiceBox" PlaceholderText="رقم الفاتورة مثال 000052" KeyDown="InvoiceBox_KeyDown" FlowDirection="RightToLeft" TextAlignment="Right"/></Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="VoidButton" Content="إلغاء الفاتورة" Click="Void_Click" IsEnabled="False" Style="{StaticResource DangerButtonStyle}"/><Button x:Name="RefundAllButton" Content="مرتجع المتبقي" Click="RefundAll_Click" IsEnabled="False" Style="{StaticResource SoftButtonStyle}"/><Button x:Name="ReprintButton" Content="إعادة طباعة" Click="Reprint_Click" IsEnabled="False" Style="{StaticResource SoftButtonStyle}"/></StackPanel><StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Stretch"><TextBlock x:Name="SaleTitle" Text="لم يتم اختيار فاتورة" FontSize="20" FontWeight="SemiBold" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/><TextBlock x:Name="SaleInfo" Foreground="{StaticResource MutedTextBrush}" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch" TextWrapping="Wrap"/></StackPanel></Grid></Border>
        <Border Grid.Row="3" Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><Grid Padding="8" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Grid.Column="4" Text="الصنف" Foreground="{StaticResource MutedTextBrush}" FlowDirection="RightToLeft" TextAlignment="Right"/><TextBlock Grid.Column="3" Text="الكمية" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center"/><TextBlock Grid.Column="2" Text="تم إرجاع" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center"/><TextBlock Grid.Column="1" Text="الإجمالي" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center"/></Grid><ListView x:Name="ItemsList"><ListView.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="8"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="مرتجع" Tag="{Binding Id}" Click="RefundItem_Click" Style="{StaticResource SoftButtonStyle}"/><TextBlock Grid.Column="1" Text="{Binding LineTotal}" Foreground="{StaticResource AccentBrushSoft}" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding RefundedQuantity}" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Quantity}" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding ProductName}" FlowDirection="RightToLeft" TextAlignment="Right" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border>
    </Grid>
</Page>
