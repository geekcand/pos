<Page x:Class="SweetsPOS.Pages.OnlinePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Padding="24" Spacing="16" MaxWidth="980" HorizontalAlignment="Right" FlowDirection="RightToLeft">
            <StackPanel>
                <TextBlock Text="أونلاين" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="ربط الكاشير بـ Supabase لرفع لوحة المتابعة تلقائياً واستقبال تحديثات الأصناف والأقسام عند توفر الإنترنت." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="11">
                    <TextBlock Text="إعداد الاتصال" Style="{StaticResource SubTitleStyle}"/>
                    <CheckBox x:Name="OnlineEnabled" Content="تفعيل المزامنة الأونلاين التلقائية"/>
                    <TextBox x:Name="SupabaseUrl" Header="Supabase Project URL" PlaceholderText="https://xxxx.supabase.co"/>
                    <PasswordBox x:Name="AnonKey" Header="Supabase anon / publishable key" PasswordRevealMode="Peek"/>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBox x:Name="StoreId" Header="معرف الفرع / الجهاز" PlaceholderText="main"/>
                        <NumberBox Grid.Column="1" x:Name="SyncMinutes" Header="المزامنة كل (دقيقة)" Minimum="1" Maximum="120" Value="5" SpinButtonPlacementMode="Compact"/>
                    </Grid>
                    <TextBlock Text="حساب جهاز المزامنة (اختياري لكن مفضل مع RLS)" Style="{StaticResource SubTitleStyle}" Margin="0,8,0,0"/>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBox x:Name="OnlineEmail" Header="Email جهاز الكاشير في Supabase Auth"/>
                        <PasswordBox Grid.Column="1" x:Name="OnlinePassword" Header="Password" PasswordRevealMode="Peek"/>
                    </Grid>
                    <CheckBox x:Name="AutoUpdates" Content="تطبيق تحديثات الأصناف والأقسام القادمة من لوحة الأونلاين تلقائياً"/>
                    <TextBlock Text="التطبيق يظل Offline-first. فشل الإنترنت لا يوقف البيع، والمزامنة تحاول مرة أخرى تلقائياً." FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="التحكم والمزامنة" Style="{StaticResource SubTitleStyle}"/>
                    <TextBlock x:Name="StatusText" Text="لم تبدأ المزامنة بعد" Foreground="{StaticResource AccentBrushSoft}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="حفظ الإعدادات" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="اختبار الاتصال" Click="Test_Click" Style="{StaticResource SoftButtonStyle}"/>
                        <Button Content="رفع البيانات الآن" Click="Sync_Click" Style="{StaticResource SoftButtonStyle}"/>
                        <Button Content="جلب التحديثات الآن" Click="Updates_Click" Style="{StaticResource SoftButtonStyle}"/>
                    </StackPanel>
                    <InfoBar x:Name="Info" IsOpen="False" IsClosable="True"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="التجهيز النهائي مع Supabase" Style="{StaticResource SubTitleStyle}"/>
                    <TextBlock Text="النسخة دي مجهزة من دلوقتي لجدولي pos_snapshots و pos_updates. لما ننتهي من التطبيق هننشئ مشروع Supabase والجداول وRLS والحسابات معاً، وبعدها تضع بيانات الاتصال هنا فقط بدون إعادة بناء التطبيق." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Text="لوحة HTML الخارجية موجودة مع السورس وجاهزة لعرض المبيعات والورديات والمخزون والمصروفات وإرسال تحديثات للأصناف والأقسام." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
