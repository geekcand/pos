<Page x:Class="SweetsPOS.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer Background="{StaticResource AppBackgroundBrush}">
<StackPanel Padding="24" Spacing="16" MaxWidth="960" HorizontalAlignment="Right" FlowDirection="RightToLeft">
<StackPanel><TextBlock Text="الإعدادات" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="بيانات المؤسسة والطباعة والنسخ الاحتياطي" Foreground="{StaticResource MutedTextBrush}"/></StackPanel>
<Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="هوية المؤسسة" Style="{StaticResource SubTitleStyle}"/><TextBox x:Name="StoreName" Header="اسم المؤسسة / المحل"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="StorePhone" Header="رقم الهاتف"/><TextBox Grid.Column="1" x:Name="Currency" Header="العملة"/></Grid><TextBox x:Name="StoreAddress" Header="العنوان"/><TextBox x:Name="ReceiptFooter" Header="رسالة أسفل الفاتورة"/><TextBlock Text="شعار الواجهة الداخلية" FontWeight="SemiBold"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="BrandLogoPath" IsReadOnly="True" PlaceholderText="سيستخدم شعار مكة الافتراضي إذا تركته فارغاً"/><Button Grid.Column="1" Content="اختيار شعار" Click="ChooseBrandLogo_Click" Style="{StaticResource SoftButtonStyle}"/><Button Grid.Column="2" Content="إزالة" Click="RemoveBrandLogo_Click" Style="{StaticResource DangerButtonStyle}"/></Grid><TextBlock Text="اسم المؤسسة والشعار يظهران أعلى يمين البرنامج ويمكن تغييرهما لأي مكان بدون إعادة بناء التطبيق." FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="المبيعات والصلاحيات" Style="{StaticResource SubTitleStyle}"/><CheckBox x:Name="TaxEnabled" Content="تفعيل الضريبة"/><NumberBox x:Name="TaxPercent" Header="نسبة الضريبة %" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact"/><NumberBox x:Name="MaxDiscount" Header="أقصى خصم للكاشير بدون موافقة مشرف %" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact"/></StackPanel></Border>
<Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="الطابعة الحرارية" Style="{StaticResource SubTitleStyle}"/><TextBox x:Name="PrinterName" Header="اسم الطابعة في Windows" PlaceholderText="اتركه فارغًا لحفظ الفواتير كملفات"/><ComboBox x:Name="ReceiptEncoding" Header="ترميز التقارير النصية" HorizontalAlignment="Stretch"><ComboBoxItem Content="utf-8"/><ComboBoxItem Content="windows-1256"/><ComboBoxItem Content="ibm864"/><ComboBoxItem Content="ibm720"/></ComboBox><TextBlock Text="الفاتورة الرئيسية الجديدة تُطبع كصورة حرارية للحفاظ على تنسيق العربية والشعار والـ QR؛ الترميز هنا يستخدم في تقارير الورديات واليومية النصية." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Border>
<StackPanel Orientation="Horizontal" Spacing="8"><Button Content="حفظ الإعدادات" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"/><Button Content="إنشاء نسخة احتياطية" Click="Backup_Click" Style="{StaticResource SoftButtonStyle}"/><Button Content="استرجاع نسخة" Click="Restore_Click" Style="{StaticResource SoftButtonStyle}"/></StackPanel><InfoBar x:Name="Info" IsOpen="False" IsClosable="True" Severity="Success"/></StackPanel></ScrollViewer></Page>
